generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Currency {
  INR
  USDT
}

enum DepositStatus {
  INITIATED
  PENDING
  PROCESSING
  SUCCESSFUL
  FAILED
  CANCELLED
  REFUNDED
}

enum UpiStatus {
  PENDING_VERIFICATION
  AVAILABLE
  UNAVAILABLE
}

enum PaymentIntentKind {
  RECEIVE
  SEND
}

enum LedgerType {
  RECHARGE
  REWARD
  ACTIVITY_REWARD
  COMMISSION
  RECEIVE
  RETURN
  TRANSFER_IN
  TRANSFER_OUT
  PAYMENT_TASK
  PAYMENT_TASK_REWARD
  INVITE_RECHARGE_ACTIVITY
  ORDER_BALANCE_TRANSFER
  GAME_BALANCE_EXCHANGE
  GAME_WITHDRAWAL
  TASK_REWARD
  WITHDRAW_APPLY
  WITHDRAW_REFUND
  WITHDRAW_SUCCESS
}

model User {
  id             String           @id @default(uuid()) @db.Uuid
  phone          String           @unique @db.VarChar(24)
  passwordHash   String
  pinHash        String?
  role           String           @default("USER") @db.VarChar(24)
  status         String           @default("ACTIVE") @db.VarChar(24)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  sessions       RefreshSession[]
  wallet         Wallet?
  deposits       DepositOrder[]
  paymentIntents PaymentIntent[]
  ledgerEntries  LedgerEntry[]
  upiAccounts    UpiAccount[]
  teamMembers    TeamMember[]     @relation("TeamOwner")
  memberOf       TeamMember?      @relation("TeamPerson")

  @@index([status, createdAt])
}

model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Wallet {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @db.Uuid
  quotaInr    Decimal  @default(0) @db.Decimal(18, 2)
  rewardRatio Decimal  @default(0) @db.Decimal(7, 4)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DepositOrder {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @db.Uuid
  currency       Currency
  network        String?       @db.VarChar(20)
  amount         Decimal       @db.Decimal(18, 2)
  quotedRate     Decimal       @db.Decimal(18, 6)
  bonusAmount    Decimal       @default(0) @db.Decimal(18, 2)
  quotaAmount    Decimal       @db.Decimal(18, 2)
  status         DepositStatus @default(INITIATED)
  idempotencyKey String        @unique @db.VarChar(100)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, currency, status, createdAt])
}

model PaymentIntent {
  id             String            @id @default(uuid()) @db.Uuid
  userId         String            @db.Uuid
  kind           PaymentIntentKind
  amount         Decimal           @db.Decimal(18, 2)
  recipient      String?           @db.VarChar(120)
  status         DepositStatus     @default(INITIATED)
  idempotencyKey String            @unique @db.VarChar(100)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, status, createdAt])
}

model LedgerEntry {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @db.Uuid
  type        LedgerType
  amount      Decimal    @db.Decimal(18, 2)
  description String     @db.VarChar(280)
  createdAt   DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt])
}

model UpiAccount {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  address     String    @db.VarChar(120)
  status      UpiStatus @default(PENDING_VERIFICATION)
  sellEnabled Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, address])
  @@index([userId, status])
}

model TeamMember {
  id              String   @id @default(uuid()) @db.Uuid
  ownerId         String   @db.Uuid
  memberId        String   @unique @db.Uuid
  rechargeTotal   Decimal  @default(0) @db.Decimal(18, 2)
  commissionTotal Decimal  @default(0) @db.Decimal(18, 2)
  joinedAt        DateTime @default(now())
  owner           User     @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  member          User     @relation("TeamPerson", fields: [memberId], references: [id], onDelete: Cascade)

  @@index([ownerId, joinedAt])
}
